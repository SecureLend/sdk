{
  "name": "securelend-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SecureLend SDK monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @securelend/sdk && npm run build --workspaces --if-present",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf packages/*/dist packages/*/node_modules",
    "publish:all": "npm run build && lerna publish",
    "dev:core": "npm run dev -w @securelend/sdk",
    "dev:react": "npm run dev -w @securelend/react",
    "dev:widgets": "npm run dev -w @securelend/widgets"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0-alpha.32",
    "@typescript-eslint/parser": "^8.0.0-alpha.32",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "lerna": "^9.0.3",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.1.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
