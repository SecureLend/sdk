{
  "name": "@securelend/sdk",
  "version": "0.1.0-beta.1",
  "description": "Official SecureLend SDK for TypeScript and JavaScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "securelend",
    "financial-services",
    "loans",
    "mortgages",
    "banking",
    "credit-cards",
    "mcp",
    "model-context-protocol",
    "typescript",
    "sdk"
  ],
  "author": "SecureLend, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/securelend/sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.securelend.ai/sdk",
  "bugs": {
    "url": "https://github.com/securelend/sdk/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
